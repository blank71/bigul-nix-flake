name:                bigul
version:             0.1.0.0
-- synopsis:            
-- description:         
license:             MIT
author:              stefan.zan, joshko
maintainer:          zantao@nii.ac.jp, hsiang-shang@nii.ac.jp 
-- copyright:           
category:            Language
build-type:          Simple
-- extra-source-files:  
cabal-version:       >=1.10

Library
  hs-source-dirs: src
  build-depends: base >= 4.7, mtl >= 2.2 && < 2.3, pretty
  default-language: Haskell2010
  exposed-modules:
    Generics.BiGUL
    Generics.BiGUL.AST
    Generics.BiGUL.Interpreter
    Generics.BiGUL.MonadBiGULError
    GHC.InOut
  default-extensions: GADTs, KindSignatures, MultiParamTypeClasses, FlexibleContexts, FlexibleInstances, DeriveGeneric, TupleSections

