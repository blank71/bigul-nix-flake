-- Initial bigul.cabal generated by cabal init.  For further documentation,
--  see http://haskell.org/cabal/users-guide/

name:                bigul
version:             0.1.0.0
-- synopsis:            
-- description:         
license:             MIT
author:              stefan.zan, joshko
maintainer:          zantao@nii.ac.jp, hsiang-shang@nii.ac.jp 
-- copyright:           
category:            Language
build-type:          Simple
-- extra-source-files:  
cabal-version:       >=1.10

Library
  hs-source-dirs: src
  build-depends: base >= 4.0, mtl >= 2.2 && < 2.3, pretty, containers, template-haskell
  default-language: Haskell2010
  exposed-modules:
    Generics.BiGUL.Error
    Generics.BiGUL.AST
    Generics.BiGUL.Interpreter
    Generics.BiGUL.Interpreter.Unsafe
    Generics.BiGUL.TH
    GHC.InOut
  default-extensions: GADTs, KindSignatures, MultiParamTypeClasses, FlexibleContexts, FlexibleInstances, DeriveGeneric, TupleSections

executable test
  main-is:            Test.hs
  hs-source-dirs:     Test, src
  build-depends:      base >= 4.0, mtl >= 2.2 && < 2.3, pretty
                    , containers
                    , template-haskell
  default-extensions: GADTs, KindSignatures, MultiParamTypeClasses
                    , FlexibleContexts, FlexibleInstances, DeriveGeneric
                    , TupleSections, TemplateHaskell
  default-language:    Haskell2010

